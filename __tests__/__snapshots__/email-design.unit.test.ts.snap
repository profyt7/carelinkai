id #E9EAED;border-radius:12px;padding:32px;font-family:Inter, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:16px;line-height:24px;color:#1A1A1A"> <h1 style="margin:0 0 16px;font-size:22px;line-height:30px;font-weight:700;color:#1A1A1A">Your Family Concierge shortlist</h1><p style="color:#1A1A1A">Thank you — your payment is received. Your full Family Concierge shortlist is ready to view.</p><table role="presentation" align="center" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:24px 0 8px" data-cta="primary"><tr><td align="center" style="text-align:center;color:#1A1A1A"><!--[if mso]><v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="https://getcarelinkai.com/concierge/shortlist/tok" style="height:44px;v-text-anchor:middle;width:260px;" arcsize="18%" stroke="f" fillcolor="#3978FC"><w:anchorlock/><center style="color:#ffffff;font-family:Arial,sans-serif;font-size:16px;font-weight:bold;">View your shortlist</center></v:roundrect><![endif]--><!--[if !mso]><!-- --><a href="https://getcarelinkai.com/concierge/shortlist/tok" class="clk-btn" style="display:inline-block;background:#3978FC;color:#ffffff;font-family:Inter, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:16px;font-weight:600;line-height:44px;padding:0 24px;border-radius:8px;text-decoration:none;mso-hide:all">View your shortlist</a><!--<![endif]--></td></tr></table><p class="clk-muted clk-fallback" align="center" style="margin:0 0 16px;font-family:Inter, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:13px;line-height:20px;color:#63666A;text-align:center"><a href="https://getcarelinkai.com/concierge/shortlist/tok" style="color:#3978FC">Open your shortlist</a></p><p class="clk-disclaimer" style="margin:0 0 14px;font-family:Inter, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:14px;line-height:21px;color:#63666A;text-align:left">You&#39;re paying for the research and shortlist, not a guaranteed opening or placement.</p><p class="clk-disclaimer" style="margin:0 0 14px;font-family:Inter, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:14px;line-height:21px;color:#63666A;text-align:left">Questions? Call us at (216) 245-9482. Please don’t share patient details on the line — share them securely at getcarelinkai.com/concierge.</p> </td></tr> <tr><td class="clk-footer" bgcolor="#F4F5F7" style="padding:20px 4px 8px;background:#F4F5F7;background-color:#F4F5F7;font-family:Inter, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:12px;line-height:18px;color:#63666A" align="center"> <span style="color:#63666A">CareLinkAI · Cleveland, Ohio · </span><a href="tel:+12162459482" style="color:#63666A;text-decoration:none">(216) 245-9482</a><br> <a href="https://getcarelinkai.com" style="color:#63666A">getcarelinkai.com</a><span style="color:#63666A"> · </span><a href="https://getcarelinkai.com/privacy" style="color:#63666A">Privacy</a><span style="color:#63666A"> · </span><a href="https://getcarelinkai.com/terms" style="color:#63666A">Terms</a> </td></tr> </table> </td></tr> </table> </body> </html>"`;

