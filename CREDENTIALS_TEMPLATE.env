# =============================================================================
# CareLinkAI - Credentials TEMPLATE
# =============================================================================
# Every value below is a placeholder. Never commit real values to this file —
# the CI secret scan (gitleaks, .github/workflows/secret-scan.yml) fails the
# build on anything that looks like a key. Real values live in your local .env
# (gitignored) and in the Render dashboard.

# 1. OpenAI API Configuration (legacy — all LLM calls now use ANTHROPIC_API_KEY)
OPENAI_API_KEY=replace-me

# 2. SMTP Email Configuration (Gmail example)
SMTP_HOST=replace-me
SMTP_PORT=replace-me
SMTP_USER=replace-me
SMTP_PASS=replace-me
SMTP_FROM=replace-me

# 3. Twilio SMS Configuration
TWILIO_ACCOUNT_SID=replace-me
TWILIO_AUTH_TOKEN=replace-me
TWILIO_PHONE_NUMBER=replace-me

# 4. Cron Job Secret (generate your own, e.g. `openssl rand -hex 32`)
CRON_SECRET=replace-me

# =============================================================================
# INSTRUCTIONS:
# 1. Copy the variables you need into your local .env and replace the values
# 2. Add the same variables to the Render Environment Variables
# =============================================================================
