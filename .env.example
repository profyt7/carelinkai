# ============================================================
# CareLinkAI — Environment Variables
# Copy this file to .env.local for local development
# Set all production values in Render dashboard > Environment
# ============================================================

# ------------------------------------------------------------
# DATABASE (required)
# ------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/carelinkai"
# Optional (OL-188): seconds `npm start` lets `prisma migrate deploy` run before
# killing it and failing the boot (scripts/migrate-deploy-with-timeout.js). Default 60.
# MIGRATE_DEPLOY_TIMEOUT_SEC=60

# ------------------------------------------------------------
# NEXTAUTH (required)
# ------------------------------------------------------------
NEXTAUTH_URL="https://getcarelinkai.com"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# ------------------------------------------------------------
# STRIPE — Payments (required for billing features)
# Keys from: https://dashboard.stripe.com/apikeys
# Webhook secret from: https://dashboard.stripe.com/webhooks
# When swapping Stripe accounts: update all 12 values below.
# ------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
# NOTE: must be NEXT_PUBLIC_ prefix — used client-side by Stripe Elements
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Operator subscription tier Price IDs (recurring monthly)
STRIPE_PRICE_STARTER="price_..."
STRIPE_PRICE_PROFESSIONAL="price_..."
STRIPE_PRICE_GROWTH="price_..."
STRIPE_PRICE_AGENCY="price_..."

# Caregiver Pro tier ($19/mo recurring)
STRIPE_PRICE_PRO_CAREGIVER="price_..."

# Provider listing fee ($99/mo recurring)
STRIPE_PRICE_PROVIDER_LISTING="price_..."

# Families are free: the CareLinkAI Plus family subscription was retired
# (OL-189). There is no family Stripe price — do not add one.

# Discharge planners are FREE (#659). There is no DP Stripe price and no DP
# billing code (removed OL-187) — do not add one.

# Family Concierge — PAID, private-pay lane only (sprint W5-3, G1). $399 one-time.
# One-time Stripe Price id (create it in the Stripe dashboard; code never creates prices).
STRIPE_PRICE_FAMILY_CONCIERGE="price_..."
# Unset (default) → the offer's button is "Request the concierge" and creates an
# unpaid request (REQUESTED_UNPAID). "1" → "Book the concierge — $399" via Stripe Checkout.
# CONCIERGE_CHECKOUT_ENABLED=1
# Monthly capacity (PAID + REQUESTED_UNPAID this calendar month). Default 4.
# When reached the button becomes "Fully booked this month — join the waitlist".
# CONCIERGE_MONTHLY_CAP=4

# Placement fee charged to operator on inquiry → resident conversion, in cents.
# Code default 250000 ($2,500) when unset (src/lib/billing/fees.ts). The founder
# sets the real value; nothing is charged until PLACEMENT_FEE_ENABLED is on AND the
# attorney (Haran) has cleared the structure. Affiliate commissions are a % of this.
# PLACEMENT_FEE_CENTS=250000
# OL-124 kill-switch: unset/0 = NO placement fee is ever recorded or invoiced.
# When "1", the fee fires ONLY for FEE_ELIGIBLE payer lanes (private funds /
# LTC insurance). Medicaid/waiver, Medicare Advantage, VA and unknown/missing
# lanes never bill — Anti-Kickback hard line per the Haran opinion. Leave unset
# until that opinion clears the structure (OL-102).
PLACEMENT_FEE_ENABLED=
# Marketplace hire access fee (cents) for operators on plans without included hires.
# One default, 9900 ($99), read only in src/lib/billing/fees.ts.
# MARKETPLACE_HIRE_FEE_CENTS=9900
# Care Wallet transaction fee percentage charged to families (default 2.5%)
WALLET_FEE_PCT=2.5
# Affiliate commission percentage of placement fee (default 20%).
# OL-185: a commission only accrues when PLACEMENT_FEE_ENABLED is on, the lane
# is FEE_ELIGIBLE and the placement-fee Stripe invoice item was created.
DEFAULT_AFFILIATE_COMMISSION_PCT=20
# OL-185 kill-switch for /api/timesheets/[id]/pay (operator pays a caregiver's
# approved timesheet via a Stripe Connect transfer). unset/0 = OFF → 503.
# Nothing charges the operator for the timesheet first, so turning this on pays
# caregivers out of the PLATFORM balance. Leave unset until an operator charge exists.
# TIMESHEET_PAYOUTS_ENABLED=

# OL-186 paid-feature kill switches. ALL DEFAULT OFF. Unset/0 → the API returns
# 503 with a plain message and the matching buttons, pages and nav links are
# hidden. "1" turns the path on. Webhooks, refunds, cancellations and the
# billing portal are never switched off. State shows at /admin/checkout-preflight.
# Ride payments: instant-book checkout + /api/rides/[id]/pay (fare + 12% fee).
# RIDES_PAYMENTS_ENABLED=1
# Care Wallet: deposits, deposit intents and pay-from-wallet (WALLET_FEE_PCT fee).
# CARE_WALLET_ENABLED=1
# Compliance kit purchases at /operator/compliance-kits (already-bought kits stay visible).
# COMPLIANCE_KITS_ENABLED=1
# Featured listing "enable" ($79 / 30 days). Disabling a featured home always works.
# FEATURED_LISTING_ENABLED=1
# Featured listing price in cents (default 7900 = $79) and window in days (default 30).
# Operators with an ACTIVE plan get it on their next invoice; everyone else pays by
# one-off Stripe Checkout and the webhook features the home once paid (OL-190).
# FEATURED_LISTING_FEE_CENTS=7900
# FEATURED_LISTING_DAYS=30
# Background check ORDERS (Checkr; free Basic included — it still costs us). Past results stay visible.
# BACKGROUND_CHECKS_ENABLED=1
# Marketplace hire fee. Off → hiring still works and NO fee is queued or recorded.
# MARKETPLACE_HIRE_FEE_ENABLED=1
# Operator plans: /api/operator/billing/subscribe + switch-plan. Off → onboarding finishes without a plan.
# OPERATOR_PLANS_ENABLED=1
# Caregiver Pro subscription (/settings/billing).
# CAREGIVER_PRO_ENABLED=1
# Provider marketplace listing subscription (/settings/provider/billing).
# PROVIDER_LISTING_ENABLED=1

# ------------------------------------------------------------
# RESEND — Transactional email (required)
# Keys from: https://resend.com/api-keys
# Verify your domain at: https://resend.com/domains
# ------------------------------------------------------------
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@getcarelinkai.com"
EMAIL_FROM_NAME="CareLinkAI"
RESEND_FROM_EMAIL="noreply@getcarelinkai.com"
# Signing secret for the Resend bounce/complaint webhook (/api/webhooks/resend).
# Get it when you add the webhook in the Resend dashboard (Webhooks → your endpoint,
# events email.bounced + email.complained). Without it the webhook rejects all posts
# in production (fail-closed). Format: whsec_...
RESEND_WEBHOOK_SECRET="whsec_..."

# ------------------------------------------------------------
# AWS S3 — PHI-classified file storage (required for HIPAA compliance)
# PHI routes: ResidentDocument, FamilyDocument, InquiryDocument, GalleryPhoto
# BAA-covered bucket. See HIPAA_PHASE_1_DESIGN.md §2.2, §4
# All S3 config uses AWS_S3_* prefix exclusively (NOT AWS_* — those are for SES)
# Bucket: carelinkai-prod-phi (production)
# ------------------------------------------------------------
AWS_S3_BUCKET="carelinkai-prod-phi"
AWS_S3_REGION="us-east-1"
AWS_S3_ACCESS_KEY_ID="AKIA..."
AWS_S3_SECRET_ACCESS_KEY="your-secret-access-key"
# Optional: for local MinIO or S3-compatible dev servers
# AWS_S3_ENDPOINT="http://localhost:9000"
# AWS_S3_FORCE_PATH_STYLE="true"
# Set to "1" to force-disable S3 (routes fall back to Cloudinary dev mode)
# AWS_S3_DISABLE="1"

# ------------------------------------------------------------
# CLOUDINARY — PUBLIC/PII image storage (non-PHI uploads)
# Keys from: https://console.cloudinary.com
# Do NOT upload PHI to Cloudinary — no BAA in place.
# ------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ------------------------------------------------------------
# ANTHROPIC — All AI features (required)
# Powers: CareBot chatbot, inquiry responses, document
# classification, discharge planner search
# Keys from: https://console.anthropic.com
# ------------------------------------------------------------
ANTHROPIC_API_KEY="sk-ant-..."

# ------------------------------------------------------------
# GOOGLE PLACES API (New) — optional
# Auto-discovers operator website URLs during directory import
# (scripts/seed-cleveland-directory.ts --with-websites) and at claim.
# Hundreds of lookups fit within the Google Maps monthly $200 free credit.
# Enable "Places API (New)" in a GCP project, create an API key, and
# enable billing. Unset = website discovery silently no-ops.
# ------------------------------------------------------------
GOOGLE_PLACES_API_KEY="your-google-places-api-key"

# ------------------------------------------------------------
# GOOGLE PROGRAMMABLE SEARCH — optional web-search fallback
# Used only when Places has no result (facility has no Google Business
# Profile). Create a Programmable Search Engine set to "search the entire
# web" and copy its ID here; enable the "Custom Search API" on the same
# GCP project. Free 100 queries/day, then $5 per 1,000.
# GOOGLE_SEARCH_API_KEY is optional — falls back to GOOGLE_PLACES_API_KEY.
# Unset = no web-search fallback (Places-only).
# ------------------------------------------------------------
GOOGLE_SEARCH_ENGINE_ID="your-programmable-search-engine-id"
GOOGLE_SEARCH_API_KEY=""

# ------------------------------------------------------------
# SENTRY — Error monitoring
# DSN from: https://sentry.io > Your Project > Settings > DSN
# ------------------------------------------------------------
SENTRY_DSN="https://xxxx@xxxx.ingest.sentry.io/xxxx"
NEXT_PUBLIC_SENTRY_DSN="https://xxxx@xxxx.ingest.sentry.io/xxxx"
NEXT_PUBLIC_ENVIRONMENT="production"

# ------------------------------------------------------------
# ANALYTICS (optional — all public keys)
# ------------------------------------------------------------
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"
NEXT_PUBLIC_FB_PIXEL_ID="1234567890123456"
NEXT_PUBLIC_CLARITY_ID="xxxxxxxxxx"

# ------------------------------------------------------------
# MAP TILES (OL-178) — MapTiler streets-v2 for every Leaflet map (listing,
# search). Public browser key: create it at cloud.maptiler.com → API keys and
# restrict it to the getcarelinkai.com origin (tiles are sent with a
# strict-origin-when-cross-origin referrer). Build-time: NEXT_PUBLIC_ vars are
# inlined, so redeploy after setting it. Unset → maps show a static
# placeholder (address + Get Directions stay) and the browser logs a warning.
# OpenStreetMap's own tile servers (403, usage policy) and CARTO (key required)
# are not used anywhere.
# ------------------------------------------------------------
NEXT_PUBLIC_MAPTILER_KEY=""

# ------------------------------------------------------------
# APP (required)
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://getcarelinkai.com"

# ------------------------------------------------------------

# ------------------------------------------------------------
# TWILIO — SMS notifications (new inquiry, tour booked, inquiry response, payment failed, tour reminders)
# ------------------------------------------------------------
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_PHONE_NUMBER="+1..."
# Random secret to secure the /api/cron/tour-reminders endpoint
# Generate with: openssl rand -hex 32
CRON_SECRET="..."

# ------------------------------------------------------------
# WEB PUSH — PWA push notifications (optional)
# Generate with: npm run generate:vapid
# ------------------------------------------------------------
# NEXT_PUBLIC_VAPID_PUBLIC_KEY="..."
# VAPID_PRIVATE_KEY="..."

# CAN-SPAM: real physical mailing address shown in cold-outreach (claim-nudge) email footers.
# REQUIRED before scripts/send-claim-nudges.ts will --force. e.g. "1234 Main St, Cleveland, OH 44114"
COMPANY_POSTAL_ADDRESS=""

# Master kill switch for the automated claim DRIP (event-driven touch-1 AND the
# daily cron's touches 2-4). PAUSED unless set to a truthy value (1/true/yes/on).
# Left UNSET on purpose (OL-109) so a redeploy can never silently resume autonomous
# outreach. Re-enable ONLY after recipient-narrowing + bounce cleanup + copy rewrite.
# CLAIM_DRIP_ENABLED="1"

# ------------------------------------------------------------
# DP LEAD-CAPTURE + FOLLOW-UP (feat/dp-lead-capture)
# ------------------------------------------------------------
# Shared secret gating the scoped /lead/new?k=<token> form (Anita's only surface).
# Generate a long random string. UNSET = the form is inert (no token is valid).
LEAD_CAPTURE_TOKEN=""

# Master kill switch for the DP follow-up sequence (immediate Touch 1 AND the daily
# cron's Touches 2-4). PAUSED unless truthy (1/true/yes/on). This lane is 1:1 warm
# outreach to planners who verbally agreed to be contacted — flip it on when live.
# Requires COMPANY_POSTAL_ADDRESS (above) to be set — sends refuse without it.
# DP_FOLLOWUP_ENABLED="1"

# Founder intro video surfaced in the DP sequence copy. Defaults to the self-hosted
# /founder page (MP4 in public/); override to swap the video without a code change.
# FOUNDER_VIDEO_URL="https://getcarelinkai.com/founder"

# DP sequence sender identity (defaults shown). Sent From a real-person verified
# address with Reply-To the delegable placements@ alias so replies collect there.
# DP_LEAD_FROM_EMAIL="chris@getcarelinkai.com"
# DP_LEAD_FROM_NAME="Chris Tolliver — CareLinkAI"
# DP_LEAD_REPLY_TO="placements@getcarelinkai.com"
# DP_PLACEMENTS_PHONE=""   # optional — shown in the email signature block if set

# ------------------------------------------------------------
# ODH STATE INSPECTION HISTORY (OL-113) — public-records ingest
# ------------------------------------------------------------
# Flag for the monthly ODH inspection refresh cron (/api/cron/odh-inspections).
# OFF unless truthy (1/true) — leave unset until the source URL is verified
# end-to-end (see docs/ODH_INSPECTION_DATA_SOURCE.md). The GHA workflow schedule
# is ALSO commented out (double-safe). File-based ingest via
# scripts/ingest-odh-inspections.ts --input works regardless of this flag.
# ODH_INGEST_ENABLED="1"
# Verified bulk source URL (normalized JSON/CSV) the cron fetches. Unset = cron
# errors out loudly instead of guessing.
# ODH_INSPECTIONS_SOURCE_URL=""

# ------------------------------------------------------------
# AVAILABILITY freshness (OL-110) — verify-on-request, never store stale "live".
# ------------------------------------------------------------
# Feature flag for the weekly availability SMS poll cron (/api/cron/availability-sms).
# OFF unless truthy (1/true/yes/on). TCPA-sensitive — do NOT enable until attorney
# sign-off + consent capture. The GHA workflow schedule is ALSO commented out, so
# BOTH must be turned on to send. Only texts homes with availabilityOptIn=true.
# AVAILABILITY_SMS_ENABLED="1"
# Shared bearer secret for the AI-voice result webhook (POST /api/availability/voice-result).
# The endpoint FAILS CLOSED (500) until this is set. Configure the same value in
# Synthflow/Retell's webhook Authorization header ("Bearer <secret>").
# AVAILABILITY_VOICE_SECRET=""
# OL-163a / OL-180: ElevenLabs post-call webhook. ElevenLabs sends every agent's
# post-call events to ONE workspace URL — register https://getcarelinkai.com/api/webhooks/elevenlabs
# (it dispatches on agent_id; /api/webhooks/elevenlabs/call-result and /inbound-lead
# still work directly). HMAC secret from the workspace webhook settings; every
# endpoint FAILS CLOSED (503) until set. Name only here — Chris sets the value in Render.
# ELEVENLABS_WEBHOOK_SECRET=""
# OL-180: which agent is which (the router's dispatch keys). Defaults below are the
# current agents; set only if an agent is replaced.
#   Front Desk (inbound calls to the published number) → inbound-lead
#   Listing Update (outbound availability calls)        → call-result
# Unknown agent_id → a homeId in the payload ⇒ call-result, else inbound-lead.
# ELEVENLABS_AGENT_ID_FRONT_DESK="agent_6101m5e81ahffwg9byc0jzw48rpw"
# ELEVENLABS_AGENT_ID_LISTING_UPDATE="agent_4201m5cre84af80r71nj41g1n603"
# OL-183: the caller id every outbound Listing Update call presents —
# +1 216 677 3569 = ElevenLabs phone number id phnum_5301m5qnzd3tejtr4yjej69ph6k6.
# Sent as agent_phone_number_id by src/lib/elevenlabs/outbound.ts; FAILS CLOSED
# (no call, error logged) when unset. /api/admin/availability/call-list reports it.
# ELEVENLABS_PHONE_NUMBER_ID="phnum_5301m5qnzd3tejtr4yjej69ph6k6"
# ElevenLabs API key (xi-api-key), needed only for programmatic batch submits.
# ELEVENLABS_API_KEY=""

# ------------------------------------------------------------
# PRICING capture (OL-111) — source-labeled prices, never a guaranteed quote.
# ------------------------------------------------------------
# Feature flag for the post-tour family quote survey trigger. When an inquiry is
# marked TOUR_COMPLETED and this is truthy (1/true/yes/on), the family gets a
# tokenized, no-login survey link to (optionally) report what they were quoted.
# OFF by default so a redeploy can never silently start emailing families.
# The survey stores NO medical info — quote amounts + care level only.
# FAMILY_QUOTE_SURVEY_ENABLED="1"
# Minimum number of VERIFIED family quote reports before a family-reported average
# is surfaced (priceSource=FAMILY_AVG). Below this, the average stays hidden.
# Defaults to 3.
# FAMILY_QUOTE_MIN_REPORTS="3"

# Where "new claim" admin notifications go when an operator claims a listing.
# Defaults to chris@getcarelinkai.com. (Legacy CLAIM_NOTIFY_EMAIL still honored as a fallback.)
ADMIN_NOTIFY_EMAIL="chris@getcarelinkai.com"
# OL-167b: mobile (E.164) that gets the one-line SMS when a discharge PLANNER calls the
# published number and asks for a callback (via the existing Twilio client; name,
# org, phone, urgency only — never the reason or transcript). Unset = SMS skipped,
# email still goes to ADMIN_NOTIFY_EMAIL. Chris sets the value in Render.
# ADMIN_NOTIFY_MOBILE="+1216XXXXXXX"
# Optional cc on the claim notification; leave unset for none. A cc equal to the
# primary recipient is dropped automatically.
# CLAIM_NOTIFY_CC=""
# Monitored inbox that operator REPLIES to cold/outreach emails land in (Reply-To).
# Defaults to ADMIN_NOTIFY_EMAIL / chris@getcarelinkai.com; the From stays noreply@.
# OUTREACH_REPLY_TO="chris@getcarelinkai.com"
# Password for every seeded demo / test account (prisma/seed*.ts, runDemoSeed,
# /api/dev/upsert-*, e2e specs). Read at seed time; there is no literal default
# (public repo). 12+ chars; use only letters, digits and @$!%*?& with at least
# one upper, lower, digit and symbol so it also passes the signup rule.
# Seeds that set ADMIN_PASSWORD / DISCHARGE_PLANNER_PASSWORD / MOCK_USER_PASSWORD
# still honor those first.
# DEMO_ACCOUNT_PASSWORD=""
